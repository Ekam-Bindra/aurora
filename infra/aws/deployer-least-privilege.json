{
  "_comment": "Least-privilege replacement for aurora-deployer's AdministratorAccess. NOT auto-applied: attach via IAM console when ready (RUNBOOK-DR.md §7). Scoped to aurora-* resources; Describe/List wildcards are unavoidable for Terraform planning.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyPlanning",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ecs:Describe*",
        "ecs:List*",
        "rds:Describe*",
        "elasticloadbalancing:Describe*",
        "ecr:Describe*",
        "ecr:List*",
        "ecr:GetAuthorizationToken",
        "logs:Describe*",
        "cloudwatch:Describe*",
        "cloudwatch:List*",
        "cloudwatch:GetDashboard",
        "sns:GetTopicAttributes",
        "sns:ListTopics",
        "sns:ListSubscriptionsByTopic",
        "iam:Get*",
        "iam:List*",
        "sts:GetCallerIdentity",
        "freetier:GetAccountPlanState"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NetworkLifecycle",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc", "ec2:DeleteVpc", "ec2:ModifyVpcAttribute",
        "ec2:CreateSubnet", "ec2:DeleteSubnet",
        "ec2:CreateRouteTable", "ec2:DeleteRouteTable", "ec2:CreateRoute", "ec2:DeleteRoute",
        "ec2:AssociateRouteTable", "ec2:DisassociateRouteTable",
        "ec2:CreateInternetGateway", "ec2:DeleteInternetGateway", "ec2:AttachInternetGateway", "ec2:DetachInternetGateway",
        "ec2:CreateNatGateway", "ec2:DeleteNatGateway",
        "ec2:AllocateAddress", "ec2:ReleaseAddress",
        "ec2:CreateSecurityGroup", "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress", "ec2:RevokeSecurityGroupEgress",
        "ec2:CreateTags", "ec2:DeleteTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ComputeAndData",
      "Effect": "Allow",
      "Action": [
        "ecs:*",
        "ecr:*",
        "rds:*",
        "elasticloadbalancing:*",
        "logs:*",
        "cloudwatch:PutDashboard", "cloudwatch:DeleteDashboards",
        "cloudwatch:PutMetricAlarm", "cloudwatch:DeleteAlarms",
        "sns:CreateTopic", "sns:DeleteTopic", "sns:SetTopicAttributes",
        "sns:Subscribe", "sns:Unsubscribe", "sns:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEqualsIfExists": { "aws:ResourceTag/Project": "aurora" }
      }
    },
    {
      "Sid": "SecretsScoped",
      "Effect": "Allow",
      "Action": ["secretsmanager:*"],
      "Resource": "arn:aws:secretsmanager:*:216812304180:secret:aurora/*"
    },
    {
      "Sid": "StateAndUploadBuckets",
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": [
        "arn:aws:s3:::aurora-terraform-state-216812304180",
        "arn:aws:s3:::aurora-terraform-state-216812304180/*",
        "arn:aws:s3:::aurora-staging-uploads-216812304180",
        "arn:aws:s3:::aurora-staging-uploads-216812304180/*",
        "arn:aws:s3:::aurora-production-uploads-216812304180",
        "arn:aws:s3:::aurora-production-uploads-216812304180/*"
      ]
    },
    {
      "Sid": "IamForAuroraRolesOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy", "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy", "iam:DetachRolePolicy",
        "iam:PassRole", "iam:TagRole"
      ],
      "Resource": "arn:aws:iam::216812304180:role/aurora-*"
    },
    {
      "Sid": "OidcProvider",
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider",
        "iam:GetOpenIDConnectProvider",
        "iam:DeleteOpenIDConnectProvider"
      ],
      "Resource": "arn:aws:iam::216812304180:oidc-provider/token.actions.githubusercontent.com"
    }
  ]
}
