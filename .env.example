# AURORA environment configuration (example).
# Copy to .env and fill in. The stack boots with these dev defaults; AI_PROVIDER
# defaults to "mock" so no external keys are required. See docs/deployment/deployment-guide.md.

# ── Core ───────────────────────────────────────────────
APP_ENV=local                       # local | staging | production
LOG_LEVEL=info
SECRET_KEY=dev-insecure-change-me-please-set-a-strong-secret-key   # JWT signing (use a strong random value in prod)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# ── Datastores (used from Phase 2 onward) ──────────────
DATABASE_URL=postgresql+psycopg://aurora:aurora@localhost:5432/aurora
POSTGRES_PASSWORD=aurora
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aurora
REDIS_URL=redis://localhost:6379/0

# ── Object storage (S3 / MinIO) ────────────────────────
S3_ENDPOINT=http://localhost:9000    # leave empty on AWS to use real S3
S3_BUCKET=aurora
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ── Analytics ──────────────────────────────────────────
ANALYTICS_ENGINE=duckdb              # duckdb | clickhouse
CLICKHOUSE_URL=

# ── AI provider abstraction ────────────────────────────
AI_PROVIDER=mock                     # mock | openai | bedrock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AWS_BEDROCK_REGION=
BEDROCK_MODEL_ID=

# ── Frontend (public) ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api/v1
