# AURORA environment configuration (example).
# Copy to .env and fill in. The stack boots with these dev defaults; AI_PROVIDER
# defaults to "mock" so no external keys are required. See docs/deployment/deployment-guide.md.

# ── Core ───────────────────────────────────────────────
APP_ENV=local                       # local | staging | production
LOG_LEVEL=info
SECRET_KEY=dev-insecure-change-me-please-set-a-strong-secret-key   # JWT signing (use a strong random value in prod)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# ── Datastores (used from Phase 2 onward) ──────────────
# Leave unset to use the in-memory store (tests / quick API-only dev).
# SQLite example (no Docker): sqlite:///./data/aurora_local.db
DATABASE_URL=sqlite:///./data/aurora_local.db
POSTGRES_PASSWORD=aurora
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aurora
REDIS_URL=redis://localhost:6379/0

# ── Object storage (S3 / MinIO) ────────────────────────
S3_ENDPOINT=http://localhost:9000    # leave empty on AWS to use real S3
S3_BUCKET=aurora
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ── Analytics ──────────────────────────────────────────
ANALYTICS_BACKEND=postgres           # postgres | clickhouse
CLICKHOUSE_URL=                      # required when ANALYTICS_BACKEND=clickhouse

# ── SSO / OIDC (Phase 9) ───────────────────────────────
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email

# ── Security (Phase 9) ─────────────────────────────────
SECURITY_HEADERS_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=20
CORS_ORIGINS=http://localhost:3000,http://localhost

# ── AI provider abstraction ────────────────────────────
AI_PROVIDER=mock                     # mock | anthropic | openai | bedrock (bedrock not implemented yet)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AWS_BEDROCK_REGION=
BEDROCK_MODEL_ID=

# ── Frontend (public) ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
